<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Abdel-Rahman Abdel-Monsef — Penetration Tester</title>
  <meta name="description" content="Professional CV of Abdel-Rahman Abdel-Monsef — Junior Penetration Tester & Web Application Security Specialist based in Cairo, Egypt.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-primary: #0a0e13;
      --bg-secondary: #0d1117;
      --bg-card: #111827;
      --bg-card-hover: #161f2e;
      --accent-green: #00ff88;
      --accent-blue: #00d4ff;
      --accent-purple: #7c3aed;
      --text-primary: #e6edf3;
      --text-secondary: #8b949e;
      --text-muted: #484f58;
      --border: rgba(0, 255, 136, 0.15);
      --border-blue: rgba(0, 212, 255, 0.2);
      --glow-green: 0 0 20px rgba(0, 255, 136, 0.3);
      --glow-blue: 0 0 20px rgba(0, 212, 255, 0.3);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--bg-primary);
      color: var(--text-primary);
      line-height: 1.6;
      min-height: 100vh;
    }

    /* ── BACKGROUND GRID ── */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(0,255,136,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,255,136,0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
      z-index: 0;
    }

    .wrapper {
      position: relative;
      z-index: 1;
      max-width: 1000px;
      margin: 0 auto;
      padding: 40px 24px 80px;
    }

    /* ── PRINT BUTTON ── */
    .print-btn {
      position: fixed;
      top: 24px;
      right: 24px;
      z-index: 100;
      background: linear-gradient(135deg, var(--accent-green), var(--accent-blue));
      color: #000;
      border: none;
      padding: 10px 20px;
      border-radius: 8px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.3s ease;
      box-shadow: var(--glow-green);
    }
    .print-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 30px rgba(0, 255, 136, 0.5);
    }

    /* ── HEADER ── */
    .header {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 32px;
      align-items: center;
      margin-bottom: 48px;
      padding: 36px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      position: relative;
      overflow: hidden;
    }

    .header::before {
      content: '';
      position: absolute;
      top: -60px;
      right: -60px;
      width: 200px;
      height: 200px;
      background: radial-gradient(circle, rgba(0,255,136,0.15) 0%, transparent 70%);
      pointer-events: none;
    }
    .header::after {
      content: '';
      position: absolute;
      bottom: -60px;
      left: 40%;
      width: 200px;
      height: 200px;
      background: radial-gradient(circle, rgba(0,212,255,0.1) 0%, transparent 70%);
      pointer-events: none;
    }

    .avatar-wrapper {
      position: relative;
    }
    .avatar-wrapper::before {
      content: '';
      position: absolute;
      inset: -4px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent-green), var(--accent-blue));
      z-index: 0;
      animation: spin-border 6s linear infinite;
    }
    @keyframes spin-border {
      0% { background: linear-gradient(0deg, var(--accent-green), var(--accent-blue)); }
      50% { background: linear-gradient(180deg, var(--accent-blue), var(--accent-green)); }
      100% { background: linear-gradient(360deg, var(--accent-green), var(--accent-blue)); }
    }
    .avatar {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      border: 4px solid var(--bg-card);
      position: relative;
      z-index: 1;
      object-fit: cover;
      display: block;
    }

    .header-info {
      position: relative;
      z-index: 1;
    }

    .terminal-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      color: var(--accent-green);
      background: rgba(0,255,136,0.08);
      border: 1px solid rgba(0,255,136,0.2);
      padding: 3px 10px;
      border-radius: 4px;
      display: inline-block;
      margin-bottom: 10px;
      letter-spacing: 1px;
    }

    .name {
      font-size: 36px;
      font-weight: 800;
      letter-spacing: -1px;
      line-height: 1.1;
      background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent-green) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 6px;
    }

    .title {
      font-size: 16px;
      color: var(--accent-blue);
      font-weight: 500;
      margin-bottom: 16px;
      font-family: 'JetBrains Mono', monospace;
    }

    .contacts {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .contact-item {
      display: flex;
      align-items: center;
      gap: 6px;
      color: var(--text-secondary);
      font-size: 13px;
      text-decoration: none;
      padding: 4px 10px;
      border: 1px solid var(--border);
      border-radius: 20px;
      transition: all 0.3s ease;
      background: rgba(0,0,0,0.3);
    }
    .contact-item:hover {
      color: var(--accent-green);
      border-color: var(--accent-green);
      box-shadow: var(--glow-green);
      transform: translateY(-1px);
    }
    .contact-item .icon {
      font-size: 14px;
    }

    /* ── SECTIONS ── */
    .section {
      margin-bottom: 32px;
    }

    .section-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
    }
    .section-header::after {
      content: '';
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, var(--border), transparent);
    }

    .section-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--accent-green);
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    .section-icon {
      font-size: 16px;
    }

    /* ── SUMMARY ── */
    .summary-card {
      background: var(--bg-card);
      border: 1px solid var(--border-blue);
      border-radius: 12px;
      padding: 24px;
      font-size: 15px;
      color: var(--text-secondary);
      line-height: 1.8;
      position: relative;
    }
    .summary-card::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 3px;
      background: linear-gradient(180deg, var(--accent-green), var(--accent-blue));
      border-radius: 3px 0 0 3px;
    }
    .summary-card strong {
      color: var(--text-primary);
    }

    /* ── CARDS GRID ── */
    .cards-grid {
      display: grid;
      gap: 16px;
    }
    .cards-grid.two-col {
      grid-template-columns: 1fr 1fr;
    }

    .card {
      background: var(--bg-card);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 12px;
      padding: 22px;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }
    .card:hover {
      border-color: var(--border);
      background: var(--bg-card-hover);
      transform: translateY(-2px);
      box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 8px;
      gap: 12px;
    }

    .card-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--text-primary);
    }

    .card-subtitle {
      font-size: 13px;
      color: var(--accent-blue);
      font-weight: 500;
      margin-bottom: 4px;
    }

    .card-meta {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 14px;
    }
    .card-meta .dot { color: var(--accent-green); }

    .cert-link {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--accent-green);
      text-decoration: none;
      border: 1px solid rgba(0,255,136,0.2);
      padding: 3px 10px;
      border-radius: 4px;
      transition: all 0.3s ease;
      white-space: nowrap;
    }
    .cert-link:hover {
      background: rgba(0,255,136,0.1);
      box-shadow: var(--glow-green);
    }

    .bullet-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .bullet-list li {
      font-size: 14px;
      color: var(--text-secondary);
      padding-left: 18px;
      position: relative;
    }
    .bullet-list li::before {
      content: '▸';
      position: absolute;
      left: 0;
      color: var(--accent-green);
      font-size: 12px;
    }

    /* ── SKILLS ── */
    .skills-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .skill-category {
      background: var(--bg-card);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 12px;
      padding: 18px;
      transition: all 0.3s ease;
    }
    .skill-category:hover {
      border-color: var(--border);
      background: var(--bg-card-hover);
    }

    .skill-cat-title {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--accent-blue);
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .skill-cat-title::before {
      content: '';
      width: 6px;
      height: 6px;
      background: var(--accent-blue);
      border-radius: 50%;
      flex-shrink: 0;
      box-shadow: var(--glow-blue);
    }

    .skill-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .tag {
      font-size: 12px;
      padding: 4px 10px;
      border-radius: 6px;
      font-family: 'JetBrains Mono', monospace;
      border: 1px solid transparent;
      transition: all 0.2s ease;
    }
    .tag-green {
      color: var(--accent-green);
      background: rgba(0,255,136,0.07);
      border-color: rgba(0,255,136,0.15);
    }
    .tag-green:hover { background: rgba(0,255,136,0.15); box-shadow: var(--glow-green); }
    .tag-blue {
      color: var(--accent-blue);
      background: rgba(0,212,255,0.07);
      border-color: rgba(0,212,255,0.15);
    }
    .tag-blue:hover { background: rgba(0,212,255,0.15); box-shadow: var(--glow-blue); }
    .tag-purple {
      color: #a78bfa;
      background: rgba(124,58,237,0.1);
      border-color: rgba(124,58,237,0.2);
    }
    .tag-purple:hover { background: rgba(124,58,237,0.2); }
    .tag-gray {
      color: var(--text-secondary);
      background: rgba(255,255,255,0.04);
      border-color: rgba(255,255,255,0.08);
    }

    /* ── CERTIFICATIONS ── */
    .cert-list {
      display: grid;
      gap: 12px;
    }
    .cert-item {
      background: var(--bg-card);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 10px;
      padding: 14px 18px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      transition: all 0.3s ease;
    }
    .cert-item:hover {
      border-color: var(--border);
      background: var(--bg-card-hover);
      transform: translateX(4px);
    }
    .cert-item-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .cert-number {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--accent-green);
      background: rgba(0,255,136,0.08);
      border: 1px solid rgba(0,255,136,0.2);
      width: 28px;
      height: 28px;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .cert-name {
      font-size: 14px;
      color: var(--text-primary);
      font-weight: 500;
    }
    .cert-issuer {
      font-size: 12px;
      color: var(--text-muted);
      font-family: 'JetBrains Mono', monospace;
    }

    /* ── PROJECTS ── */
    .project-card {
      background: var(--bg-card);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 12px;
      padding: 22px;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }
    .project-card::after {
      content: '';
      position: absolute;
      top: 0; right: 0;
      width: 80px; height: 80px;
      background: radial-gradient(circle at top right, rgba(0,255,136,0.08), transparent);
    }
    .project-card:hover {
      border-color: var(--border);
      background: var(--bg-card-hover);
      transform: translateY(-3px);
      box-shadow: 0 12px 40px rgba(0,0,0,0.4);
    }
    .project-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--accent-green);
      margin-bottom: 6px;
    }
    .project-desc {
      font-size: 14px;
      color: var(--text-secondary);
      line-height: 1.7;
      margin-bottom: 14px;
    }
    .project-stack {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 12px;
    }
    .project-links {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    /* ── VOLUNTEER ── */
    .volunteer-card {
      background: var(--bg-card);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 12px;
      padding: 18px 22px;
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 16px;
      align-items: start;
      transition: all 0.3s ease;
    }
    .volunteer-card:hover {
      border-color: var(--border);
      background: var(--bg-card-hover);
      transform: translateX(4px);
    }
    .vol-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: rgba(0,255,136,0.08);
      border: 1px solid rgba(0,255,136,0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      flex-shrink: 0;
    }
    .vol-role {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
    }
    .vol-org {
      font-size: 13px;
      color: var(--accent-blue);
    }
    .vol-desc {
      font-size: 13px;
      color: var(--text-muted);
      margin-top: 4px;
    }
    .date-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      color: var(--text-muted);
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      padding: 3px 8px;
      border-radius: 4px;
      white-space: nowrap;
    }

    /* ── PLATFORM STATS ── */
    .platform-cards {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .platform-card {
      background: var(--bg-card);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 12px;
      padding: 22px;
      text-align: center;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }
    .platform-card:hover {
      border-color: var(--border);
      background: var(--bg-card-hover);
      transform: translateY(-3px);
      box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    }
    .platform-logo {
      font-size: 32px;
      margin-bottom: 8px;
    }
    .platform-name {
      font-size: 14px;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 4px;
    }
    .platform-username {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      color: var(--accent-green);
      margin-bottom: 14px;
    }
    .platform-stats {
      display: flex;
      justify-content: center;
      gap: 20px;
    }
    .stat-item {
      text-align: center;
    }
    .stat-val {
      font-family: 'JetBrains Mono', monospace;
      font-size: 20px;
      font-weight: 700;
      color: var(--accent-green);
    }
    .stat-label {
      font-size: 10px;
      color: var(--text-muted);
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    .placeholder-note {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      color: rgba(255,165,0,0.6);
      border: 1px dashed rgba(255,165,0,0.3);
      padding: 3px 8px;
      border-radius: 4px;
      display: inline-block;
      margin-top: 8px;
    }

    /* ── LANGUAGES ── */
    .lang-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .lang-card {
      background: var(--bg-card);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 12px;
      padding: 20px;
      transition: all 0.3s ease;
    }
    .lang-card:hover {
      border-color: var(--border);
      background: var(--bg-card-hover);
    }
    .lang-name {
      font-size: 15px;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 4px;
    }
    .lang-level {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      color: var(--accent-blue);
      margin-bottom: 12px;
    }
    .lang-bar-bg {
      height: 4px;
      background: rgba(255,255,255,0.06);
      border-radius: 2px;
      overflow: hidden;
    }
    .lang-bar-fill {
      height: 100%;
      border-radius: 2px;
      background: linear-gradient(90deg, var(--accent-green), var(--accent-blue));
      transition: width 1.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* ── FOOTER ── */
    .footer {
      text-align: center;
      margin-top: 48px;
      padding: 24px;
      border-top: 1px solid rgba(255,255,255,0.06);
    }
    .footer-text {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      color: var(--text-muted);
    }
    .footer-text span {
      color: var(--accent-green);
    }

    /* ── ANIMATIONS ── */
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .section {
      animation: fadeInUp 0.6s ease forwards;
    }

    /* ── PRINT STYLES ── */
    @media print {
      body { background: #fff !important; color: #000 !important; }
      body::before { display: none; }
      .print-btn { display: none !important; }
      :root {
        --bg-primary: #fff;
        --bg-secondary: #fff;
        --bg-card: #f8f9fa;
        --bg-card-hover: #f0f1f2;
        --accent-green: #006644;
        --accent-blue: #0066cc;
        --text-primary: #1a1a1a;
        --text-secondary: #333;
        --text-muted: #666;
        --border: rgba(0,0,0,0.15);
        --border-blue: rgba(0,0,0,0.1);
        --glow-green: none;
        --glow-blue: none;
      }
      .header { border: 1px solid #ddd; }
      .name { -webkit-text-fill-color: #1a1a1a; }
      .wrapper { padding: 0; max-width: 100%; }
      .section { break-inside: avoid; }
    }

    @media (max-width: 700px) {
      .header { grid-template-columns: 1fr; text-align: center; }
      .avatar-wrapper { margin: 0 auto; }
      .contacts { justify-content: center; }
      .skills-grid, .platform-cards, .lang-grid, .cards-grid.two-col { grid-template-columns: 1fr; }
      .volunteer-card { grid-template-columns: auto 1fr; }
      .date-badge { display: none; }
      .name { font-size: 26px; }
    }
  </style>
</head>
<body>

  <button class="print-btn" onclick="window.print()" id="print-cv-btn">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
    Print / Save PDF
  </button>

  <div class="wrapper">

    <!-- ═══════════ HEADER ═══════════ -->
    <div class="header">
      <div class="avatar-wrapper">
        <img class="avatar" src="photo/pic.jpg" alt="Abdel-Rahman Abdel-Monsef" id="profile-photo">
      </div>
      <div class="header-info">
        <div class="terminal-tag">$ whoami</div>
        <h1 class="name">Abdel-Rahman Abdel-Monsef</h1>
        <div class="title">Junior Penetration Tester &amp; Web Application Security Specialist</div>
        <div class="contacts">
          <a class="contact-item" href="tel:+201272862660" id="phone-1">
            <span class="icon">📞</span> +20 127 286 2660
